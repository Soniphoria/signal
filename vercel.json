{
  "buildCommand": "cd app && npm run build",
  "installCommand": "npm install && cd app && npm install",
  "outputDirectory": "app/dist",
  "framework": null,
  "rewrites": [
    { "source": "/azure-proxy/:path*", "destination": "/api/azure-proxy" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/edit", "destination": "/edit.html" },
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/profile", "destination": "/community.html" },
    { "source": "/home", "destination": "/community.html" },
    { "source": "/users/:path*", "destination": "/community.html" },
    { "source": "/songs/:path*", "destination": "/community.html" },
    { "source": "/projects/:path*/midi_tracks", "destination": "/edit.html" },
    { "source": "/projects/:path*", "destination": "/edit.html" },
    { "source": "/track", "destination": "/edit.html" },
    { "source": "/arrange", "destination": "/edit.html" },
    { "source": "/tempo", "destination": "/edit.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, PATCH, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-Requested-With, content-type, Authorization"
        }
      ]
    }
  ]
}
